# ==============================================================================
# SENTRIQ - Application Security Intelligence Platform
# Environment Configuration Template
# Copy this file to .env before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=Sentriq
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Allowed CORS origins (comma-separated)
# Development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (set this value in Render's environment variables):
# CORS_ORIGINS=https://sentriq-rouge.vercel.app

# Frontend URL (used to generate email verification & password recovery links)
# Development:
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://sentriq-rouge.vercel.app

# Scanner Safety & SSRF Limits
# Set to false in production to prevent scanning loopback and private RFC1918 IPs
ALLOW_INTERNAL_TARGETS=false
SCANNER_TIMEOUT_SECONDS=10.0
SCANNER_MAX_RESPONSE_SIZE=2097152

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Default: Local SQLite database via async driver (zero-configuration development)
DATABASE_URL=sqlite+aiosqlite:///./sentriq.db

# Production (Supabase PostgreSQL via pooled connection string):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Authentication & Session Security (Phase 3+)
# ------------------------------------------------------------------------------
# High-entropy random key for HMAC session signing and CSRF token generation
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sentriq-dev-secret-key-32-byte-hex-entropy-change-in-prod

# Session Cookie Configuration
SESSION_COOKIE_NAME=sentriq_session
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Production Authentication Activation (Keep False until all stages pass)
AUTH_ENABLED=false
PRODUCTION_AUTH_VERIFIED=false

# ------------------------------------------------------------------------------
# Email Delivery Provider (Resend HTTPS API)
# ------------------------------------------------------------------------------
# Sign up at https://resend.com and generate an API key under API Keys.
# In local development: If omitted, emails are captured in the in-memory outbox.
# In production on Render: Set this variable to enable live delivery.
# RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Sender Address (EMAIL_FROM):
# 1. Sandbox Testing: Resend provides "onboarding@resend.dev" which delivers ONLY to
#    your registered account email for development/testing.
# 2. Production Domain: Add your domain (e.g. sentriq.io) in the Resend Domains dashboard,
#    configure the DNS TXT (SPF) and CNAME (DKIM) records, and set:
#    EMAIL_FROM=Sentriq Security <security@yourverifieddomain.com>
EMAIL_FROM=Sentriq Security <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# GitHub OAuth 2.0 Credentials (Optional)
# ------------------------------------------------------------------------------
# Register a GitHub OAuth App at: https://github.com/settings/developers
# Homepage URL: https://sentriq-rouge.vercel.app
# Authorization callback URL: https://sentriq-rouge.vercel.app/api/auth/github/callback
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_REDIRECT_URI=https://sentriq-rouge.vercel.app/api/auth/github/callback
