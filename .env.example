# ==============================================================================
# SENTRIQ - Application Security Intelligence Platform
# Environment Configuration Template
# Copy this file to .env before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=Sentriq
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Allowed CORS origins (comma-separated)
# Development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (set this value in Render's environment variables):
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sentriq-rouge.vercel.app

# Scanner Safety & SSRF Limits
# Set to false in production to prevent scanning loopback and private RFC1918 IPs
ALLOW_INTERNAL_TARGETS=false
SCANNER_TIMEOUT_SECONDS=10.0
SCANNER_MAX_RESPONSE_SIZE=2097152

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Default: Local SQLite database via async driver (zero-configuration development)
DATABASE_URL=sqlite+aiosqlite:///./sentriq.db

# Production (e.g. Supabase / PostgreSQL free tier):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Future Phase Configuration Placeholders (Phase 2+)
# (Not required for Phase 1 foundation)
# ------------------------------------------------------------------------------
# SECRET_KEY=replace_with_a_secure_random_hex_for_jwt_session_signing
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AI_PROVIDER_API_KEY=
